# Docker deployment options for docker-compose.self-hosted.yml.
# Runtime secrets stay in server/.env.

# Public host port exposed by Docker.
IMAGE_STUDIO_API_HOST_PORT=8787

# Docker image and release tag used by host-side updates.
IMAGE_STUDIO_API_IMAGE=ghcr.io/jellyliu-nuwen/image-studio-api
IMAGE_STUDIO_API_TAG=v1.2.5

# Repository checked by the admin update panel.
IMAGE_STUDIO_GITHUB_REPOSITORY=JellyLiu-NuWen/Image-Studio-API
